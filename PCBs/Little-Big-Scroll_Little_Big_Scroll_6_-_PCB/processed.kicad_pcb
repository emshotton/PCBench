  (gr_text "+\n-" (at 120.82 49.77) (layer "B.SilkS") (tstamp d19b09d5-ace0-44fa-a2fe-06e3822c1d45)
    (effects (font (size 1 1) (thickness 0.15)) (justify mirror))
  )
  (gr_text "1. Solder hotswap sockets from rear of PCB, follow outline\n2. Solder capacitors (C1 & C2) from rear (unidirectional)\n3. Cut ends of legs flush on front side (underneath encoder)\n4. Solder RGB from rear, orient by arrow/marked leg \n5. Solder controller on rear of PCB, facing up\n6. Solder encoder from front of PCB (Bend ground tabs!)\n7. Assemble, Flash and Enjoy!" (at 127.57 47.33 90) (layer "B.SilkS") (tstamp dbe3042a-d399-4794-85c1-e0c1cc6f7956)
    (effects (font (size 1 1) (thickness 0.15)) (justify left mirror))
  )
  (gr_text "JLCJLCJLCJLC" (at 94.83 87.96) (layer "B.SilkS") (tstamp ea84d6c1-7995-47e1-9817-9e2e1b9b4529)
    (effects (font (size 0.8 0.8) (thickness 0.15)) (justify mirror))
  )
  (gr_text "If going wireless, add a \n<5mm thick battery\nhere and solder the \nbattery cut-off switch\non back of PCB. \n\nHard soldering the\nbattery is recommended\nfor heigh contraints.\n\nWarning!!!\nVerify polarity on \nbattery before \nsoldering!" (at 119.59 68.3) (layer "F.SilkS") (tstamp 159c2591-7376-425a-87cc-455b3a32f52d)
